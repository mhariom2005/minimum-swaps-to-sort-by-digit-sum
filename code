import java.util.*;

public class Main {
public static int minSwaps(int[] nums) {
int n = nums.length;
int[][] arr = new int[n][2];

    for (int i = 0; i < n; i++) {
        arr[i][0] = nums[i];
        arr[i][1] = digitSum(nums[i]);
    }

    Arrays.sort(arr, (a, b) -> {
        if (a[1] != b[1]) return a[1] - b[1];
        return a[0] - b[0];
    });

    Map<Integer, Integer> map = new HashMap<>();

    for (int i = 0; i < n; i++) {
        map.put(arr[i][0], i);
    }

    boolean[] visited = new boolean[n];
    int swaps = 0;

    for (int i = 0; i < n; i++) {
        if (visited[i] || map.get(nums[i]) == i) continue;

        int j = i;
        int count = 0;

        while (!visited[j]) {
            visited[j] = true;
            j = map.get(nums[j]);
            count++;
        }

        swaps += count - 1;
    }

    return swaps;
}

private static int digitSum(int n) {
    int sum = 0;

    while (n > 0) {
        sum += n % 10;
        n /= 10;
    }

    return sum;
}

public static void main(String[] args) {
    int[] nums = {18, 43, 34, 16};
    System.out.println(minSwaps(nums));
}


}
